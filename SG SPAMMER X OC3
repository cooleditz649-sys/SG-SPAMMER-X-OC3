-- ==================== AUTO TMKX GENERATOR & TARGET POOL ====================
local function shuffleList(list)
    local copy = table.clone(list)
    for i = #copy, 2, -1 do
        local j = math.random(1, i)
        copy[i], copy[j] = copy[j], copy[i]
    end
    return copy
end

local function buildAutoMessagePool()
    local pool = table.clone(baseList)
    for _ = 1, 6 do
        local shuffledWords = shuffleList(tmkxWords)
        local line = "TMKX " .. table.concat(shuffledWords, " ", 1, math.min(9, #shuffledWords))
        table.insert(pool, line)
    end
    return shuffleList(pool)
end

local function getActiveTargets()
    local customTargets = {}
    for _, box in ipairs(targetBoxes) do
        local trimmed = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" then
            table.insert(customTargets, trimmed)
        end
    end
    if #customTargets > 0 then
        return customTargets
    end
    return fallbackTargets
end

local function pickTargetName()
    local pool = getActiveTargets()
    if cycleEnabled then
        local chosen = pool[((targetWordIndex - 1) % #pool) + 1]
        targetWordIndex += 1
        return chosen
    end
    return pool[math.random(1, #pool)]
end

local function formatTargetBlock(activeTarget)
    if emojiCycleEnabled then
        local chosenEmoji = randomEmojis[math.random(1, #randomEmojis)]
        return "[" .. activeTarget .. " (" .. chosenEmoji .. " )"
    end
    return "[" .. activeTarget .. "]"
end

StartBtn.MouseButton1Click:Connect(function()
    if isRunning then
        isRunning = false
        StartBtn.Text = "START SG SPAMMER"
        StartBtn.TextColor3 = Color3.fromRGB(225, 65, 255)
    else
        isRunning = true
        StartBtn.Text = "STOP SG SPAMMER"
        StartBtn.TextColor3 = Color3.fromRGB(255, 85, 110)

        task.spawn(function()
            local shuffledQueue = buildAutoMessagePool()
            local queuePos = 1

            while isRunning do
                if queuePos > #shuffledQueue then
                    shuffledQueue = buildAutoMessagePool()
                    queuePos = 1
                end

                local phrase = shuffledQueue[queuePos]
                queuePos += 1

                local activeTarget = pickTargetName()
                local fullPrefix = BASE_PREFIX .. selectedStyle
                local targetPart = formatTargetBlock(activeTarget)
                local finalMsg = fullPrefix .. targetPart .. phrase

                sendChat(finalMsg)

                local waitTime = tonumber(DelayInput.Text) or 0.8
                task.wait(math.max(waitTime, 0.8))
            end
        end)
    end
end)

